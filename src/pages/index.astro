<style>
  :root {
    --bg: #fbfaf7;
    --surface: #f3efe8;
    --text: #23201b;
    --muted: #6e675d;
    --accent: #b05e12;
    --rail: #e3dccf;
    --sans: "Inter", system-ui, sans-serif;
    --mono: "Inter", system-ui, sans-serif;
    --display: "Inter", system-ui, sans-serif;
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background:
      radial-gradient(
        56rem 34rem at 18% -6%,
        color-mix(in srgb, var(--accent) 5%, transparent),
        transparent 70%
      ),
      var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rail);
  }

  .site-nav-inner {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0.7rem clamp(1.25rem, 5vw, 2rem);
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav-inner::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 34rem) {
    .site-nav-inner {
      justify-content: center;
    }
  }

  .site-nav a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--accent);
  }

  section[id],
  footer[id] {
    scroll-margin-top: 4rem;
  }

  main {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 8vw, 6rem) clamp(1.25rem, 5vw, 2rem) 3rem;
  }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.25s ease, color 0.25s ease;
  }

  a:hover,
  a:focus-visible {
    text-decoration-color: var(--accent);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.5rem, 4vw, 1.9rem);
    letter-spacing: -0.01em;
    margin-bottom: 1.9rem;
  }

  h2::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
    margin-bottom: 1.1rem;
  }

  section,
  footer {
    margin-top: clamp(3.5rem, 10vw, 5.5rem);
  }

  /* ---------- hero ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .avatar {
    position: relative;
    width: 8.25rem;
    height: 8.25rem;
    margin-bottom: 1.9rem;
  }

  .avatar img,
  .monogram {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid var(--rail);
  }

  .avatar img {
    object-fit: cover;
    z-index: 1;
  }

  .monogram {
    display: grid;
    place-items: center;
    background: var(--surface);
    font-family: var(--display);
    font-weight: 600;
    font-size: 2.4rem;
    color: var(--accent);
  }

  .chip {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: -0.7rem;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--rail);
    border-radius: 999px;
    padding: 0.18rem 0.7rem;
    white-space: nowrap;
  }

  .hero h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.3rem, 8vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .hero .tagline {
    margin-top: 1.2rem;
    font-weight: 500;
    font-size: clamp(1.15rem, 3.4vw, 1.4rem);
    color: var(--accent);
  }

  .hero .intro {
    margin-top: 1.4rem;
    max-width: 36rem;
    color: color-mix(in srgb, var(--text) 88%, var(--muted));
  }

  .cards {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    width: 100%;
    max-width: 36rem;
  }

  @media (min-width: 34rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--rail);
    border-radius: 14px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.25s ease, transform 0.25s ease,
      background-color 0.25s ease;
  }

  .card:hover,
  .card:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 65%, var(--rail));
    background: color-mix(in srgb, var(--surface) 92%, var(--accent));
    transform: translateY(-2px);
  }

  .card svg {
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    color: var(--accent);
  }

  .card-text {
    display: grid;
    text-align: left;
    line-height: 1.3;
  }

  .card-text small {
    font-size: 0.74rem;
    color: var(--muted);
  }

  .card-text strong {
    font-weight: 600;
    font-size: 0.95rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .card:focus-visible {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero > * {
      animation: rise 0.6s ease both;
