    <script>
      const timeline = document.querySelector(".timeline");
      const yearEl = document.getElementById("year-now");
      const stops = Array.from(document.querySelectorAll(".stop"));

      if (timeline && yearEl && stops.length && "IntersectionObserver" in window) {
        timeline.classList.add("js");

        let current = null;

        const setYear = (text) => {
          if (yearEl.textContent === text) return;
          yearEl.classList.add("swap");
          setTimeout(() => {
            yearEl.textContent = text;
            yearEl.classList.remove("swap");
          }, 150);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("seen");
              if (current !== entry.target) {
                current?.classList.remove("active");
                current = entry.target;
                current.classList.add("active");
                const years = current.querySelector(".years")?.textContent ?? "";
                const firstYear = years.match(/\d{4}/)?.[0] ?? "";
                if (firstYear) setYear(firstYear);
              }
            }
          },
          { rootMargin: "-35% 0px -45% 0px" }
        );

        stops.forEach((s) => observer.observe(s));

        // before any scroll, light up the first entry
        stops[0].classList.add("active", "seen");
        current = stops[0];

        // mobile chip: only visible while the timeline is on screen
        new IntersectionObserver(
          (entries) => {
            document.body.classList.toggle(
              "tl-visible",
              entries[0].isIntersecting
            );
          },
          { rootMargin: "-15% 0px -15% 0px" }
        ).observe(timeline);
      }
    </script>
